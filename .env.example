# Database
DATABASE_URL="postgresql://copilot:copilot_dev@localhost:5432/assessment_copilot"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO / S3
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="assessment-documents"
S3_REGION="us-east-1"

# Auth
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Claude API
ANTHROPIC_API_KEY="your-anthropic-api-key"
# Optional — override the model used by every AI call. Defaults to
# `claude-sonnet-4-5` (rolling alias). Pin a dated snapshot if you
# want deterministic behaviour, or swap tier for cost/speed:
#   claude-sonnet-4-5              # default (balanced)
#   claude-sonnet-4-5-20250929     # pinned snapshot
#   claude-opus-4-5                # smarter, slower, pricier
#   claude-haiku-4-5               # cheaper, faster, less capable
# Confirm your key's access with /v1/models (see claude-client.ts comment).
ANTHROPIC_MODEL="claude-sonnet-4-5"

# OpenAI (embeddings — Phase 3 Week 3, ADR-0003)
# Leave `OPENAI_API_KEY` blank (or set `EMBEDDING_MODE=fake`) to run
# without a funded account; ingest will use deterministic pseudo-
# vectors so the pipeline still exercises the embedding code path.
OPENAI_API_KEY=""
# Override the model if the default is deprecated or you want to
# trade off cost/quality. `text-embedding-3-small` is the ADR-0003
# default (1536-dim, $0.02 / 1M tokens as of 2026-04).
EMBEDDING_MODEL="text-embedding-3-small"
# `live` = call the OpenAI API. `fake` = deterministic hash-derived
# vectors, for CI / local dev without a key. Leave unset to infer
# from presence/absence of `OPENAI_API_KEY`.
# EMBEDDING_MODE="live"

# Repository credentials (Phase 3 Week 6, ADR-0009)
# 32-byte base64, generate with `openssl rand -base64 32`. Encrypts
# engagement-scoped GitHub PATs at rest (AES-256-GCM). Or set
# REPO_CREDENTIAL_MODE=fake for dev without a real key.
REPO_CREDENTIAL_KEY=""
# `fake` = use a fixed dev-only key so credentials.ts doesn't throw
# when REPO_CREDENTIAL_KEY is unset. Never use in production.
# REPO_CREDENTIAL_MODE=fake

# Worker logging (Phase 3 Week 8)
# `1` = pretty-print worker logs in dev; production emits
# structured JSON. Unset/0 for prod-shaped log output locally.
DEBUG_WORKERS=1

# PlantUML (diagram rendering)
PLANTUML_SERVER_URL="http://localhost:8081"

# Feature flags are DB-backed (Setting table) and toggled from
# /admin/settings?tab=ai-router — no env vars. Off by default on
# fresh deploys.

# App
NODE_ENV="development"
