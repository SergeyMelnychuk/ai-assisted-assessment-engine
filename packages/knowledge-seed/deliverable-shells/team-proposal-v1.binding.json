{
  "version": 1,
  "templateKind": "TEAM_PROPOSAL",
  "notes": "Hand-authored workspace-default binding for the Team Proposal v1 docx. seed: {\"name\":\"Team Proposal\",\"version\":\"v1\",\"kind\":\"TEAM_PROPOSAL\"}. The Proposed-team and Per-role-justification tables use `docx.tableRow` — the filler clones each template row once per role at fill time, substituting the per-row tokens with the role's values. Per-role hours/cost columns are deliberately absent — the engine doesn't compute them today (ADR-0018 deferred); only Count + Seniority + Phase + Responsibilities + Justification are real per-role fields. The engagement-totals table holds the rolled-up numbers separately.",
  "entries": [
    {
      "field": "project.name",
      "target": { "kind": "docx.placeholder", "token": "{{project_name}}" },
      "format": "auto",
      "note": "Cover > project name."
    },
    {
      "field": "engagement.clientName",
      "target": { "kind": "docx.placeholder", "token": "{{client_name}}" },
      "format": "auto",
      "note": "Cover > client name."
    },
    {
      "field": "engagement.name",
      "target": { "kind": "docx.placeholder", "token": "{{engagement_name}}" },
      "format": "auto",
      "note": "Cover > engagement name."
    },
    {
      "field": "generated.date",
      "target": { "kind": "docx.placeholder", "token": "{{generated_date}}" },
      "format": "date",
      "note": "Cover > generation date."
    },
    {
      "field": "totals.scenarioName",
      "target": { "kind": "docx.placeholder", "token": "{{scenario_name}}" },
      "format": "auto",
      "note": "Engagement totals > scenario name."
    },
    {
      "field": "totals.currency",
      "target": { "kind": "docx.placeholder", "token": "{{totals_currency}}" },
      "format": "auto",
      "note": "Engagement totals > currency code."
    },
    {
      "field": "totals.effortHoursLow",
      "target": { "kind": "docx.placeholder", "token": "{{totals_effort_low}}" },
      "format": "auto",
      "note": "Engagement totals > effort hours (low)."
    },
    {
      "field": "totals.effortHoursHigh",
      "target": { "kind": "docx.placeholder", "token": "{{totals_effort_high}}" },
      "format": "auto",
      "note": "Engagement totals > effort hours (high)."
    },
    {
      "field": "totals.costLow",
      "target": { "kind": "docx.placeholder", "token": "{{totals_cost_low}}" },
      "format": "currency",
      "note": "Engagement totals > cost (low)."
    },
    {
      "field": "totals.costHigh",
      "target": { "kind": "docx.placeholder", "token": "{{totals_cost_high}}" },
      "format": "currency",
      "note": "Engagement totals > cost (high)."
    },
    {
      "field": "totals.confidence",
      "target": { "kind": "docx.placeholder", "token": "{{totals_confidence}}" },
      "format": "percent",
      "note": "Engagement totals > confidence."
    },
    {
      "field": "totals.assumptions",
      "target": { "kind": "docx.placeholder", "token": "{{totals_assumptions}}" },
      "format": "auto",
      "note": "Assumptions section > narrative paragraph."
    },
    {
      "field": "section.team_proposal_overview",
      "target": { "kind": "docx.placeholder", "token": "{{section_team_proposal_overview}}" },
      "format": "auto",
      "note": "AI-written engagement-context narrative."
    },
    {
      "field": "roles[*].roleName",
      "target": { "kind": "docx.tableRow", "token": "{{role_name}}" },
      "groupKey": "roles",
      "format": "auto",
      "note": "Proposed team table > Role column."
    },
    {
      "field": "roles[*].seniority",
      "target": { "kind": "docx.tableRow", "token": "{{role_seniority}}" },
      "groupKey": "roles",
      "format": "auto",
      "note": "Proposed team table > Seniority column."
    },
    {
      "field": "roles[*].count",
      "target": { "kind": "docx.tableRow", "token": "{{role_count}}" },
      "groupKey": "roles",
      "format": "auto",
      "note": "Proposed team table > Count column."
    },
    {
      "field": "roles[*].phase",
      "target": { "kind": "docx.tableRow", "token": "{{role_phase}}" },
      "groupKey": "roles",
      "format": "auto",
      "note": "Proposed team table > Phase column (may be empty)."
    },
    {
      "field": "roles[*].responsibilities",
      "target": { "kind": "docx.tableRow", "token": "{{role_responsibilities}}" },
      "groupKey": "roles",
      "format": "auto",
      "note": "Proposed team table > Responsibilities column."
    },
    {
      "field": "roles[*].roleName",
      "target": { "kind": "docx.tableRow", "token": "{{role_name_just}}" },
      "groupKey": "roles_justification",
      "format": "auto",
      "note": "Per-role justification table > Role column (same role list as above; we re-bind under a distinct token because each table has its own template row)."
    },
    {
      "field": "roles[*].justification",
      "target": { "kind": "docx.tableRow", "token": "{{role_justification}}" },
      "groupKey": "roles_justification",
      "format": "auto",
      "note": "Per-role justification table > Justification column."
    }
  ]
}
