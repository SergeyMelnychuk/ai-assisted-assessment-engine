{
  "version": 1,
  "templateKind": "ASSESSMENT_REPORT",
  "notes": "Workspace-default binding for the Assessment Report v1 Word shell. The shell carries 10 sections (cover, executive summary, engagement context, current state, findings, risks, recommendations, target state, roadmap, assumptions, appendix). Engine fills cover + cross-section metadata; AI writes the prose for executive_summary, engagement_context, current_state, key_findings, risks, recommendations, target_state, team_and_estimate via `section.<key>` fields (declared in `deliverable-templates/assessment-report.json`). Previous binding mapped findings/risks/recommendations to `*.bulletList` raw dumps with internal '[severity/domain]' prefixes — that produced unreadable narrative. seed: {\"name\":\"Assessment Report\",\"version\":\"v1\",\"kind\":\"ASSESSMENT_REPORT\"}",
  "entries": [
    {
      "field": "project.name",
      "target": { "kind": "docx.placeholder", "token": "{{project_name}}" },
      "format": "auto",
      "note": "Cover + Engagement context; reused on the project line on every section that needs it."
    },
    {
      "field": "project.industry",
      "target": { "kind": "docx.placeholder", "token": "{{project_industry}}" },
      "format": "auto",
      "note": "Engagement context section."
    },
    {
      "field": "project.description",
      "target": { "kind": "docx.placeholder", "token": "{{project_description}}" },
      "format": "auto",
      "note": "Engagement context > Project description paragraph."
    },
    {
      "field": "project.businessGoals",
      "target": { "kind": "docx.placeholder", "token": "{{project_business_goals}}" },
      "format": "auto",
      "note": "Engagement context > Business goals paragraph."
    },
    {
      "field": "project.expectedTimeline",
      "target": { "kind": "docx.placeholder", "token": "{{project_timeline}}" },
      "format": "auto",
      "note": "Engagement context + Roadmap sections."
    },
    {
      "field": "engagement.name",
      "target": { "kind": "docx.placeholder", "token": "{{engagement_name}}" },
      "format": "auto",
      "note": "Cover + Engagement context — engagement label."
    },
    {
      "field": "engagement.clientName",
      "target": { "kind": "docx.placeholder", "token": "{{client_name}}" },
      "format": "auto",
      "note": "Cover (Prepared for) + Engagement context."
    },
    {
      "field": "totals.scenarioName",
      "target": { "kind": "docx.placeholder", "token": "{{scenario_name}}" },
      "format": "auto",
      "note": "Executive summary, Roadmap, Appendix — scenario label."
    },
    {
      "field": "totals.effortHoursLow",
      "target": { "kind": "docx.placeholder", "token": "{{effort_hours_low}}" },
      "format": "auto",
      "note": "Executive summary headline figure."
    },
    {
      "field": "totals.effortHoursHigh",
      "target": { "kind": "docx.placeholder", "token": "{{effort_hours_high}}" },
      "format": "auto",
      "note": "Executive summary headline figure."
    },
    {
      "field": "totals.costLow",
      "target": { "kind": "docx.placeholder", "token": "{{cost_low}}" },
      "format": "currency",
      "note": "Executive summary headline figure."
    },
    {
      "field": "totals.costHigh",
      "target": { "kind": "docx.placeholder", "token": "{{cost_high}}" },
      "format": "currency",
      "note": "Executive summary headline figure."
    },
    {
      "field": "totals.confidence",
      "target": { "kind": "docx.placeholder", "token": "{{confidence}}" },
      "format": "percent",
      "note": "Executive summary + Appendix — model confidence."
    },
    {
      "field": "totals.assumptions",
      "target": { "kind": "docx.placeholder", "token": "{{assumptions}}" },
      "format": "auto",
      "note": "Assumptions section body paragraph."
    },
    {
      "field": "totals.currency",
      "target": { "kind": "docx.placeholder", "token": "{{currency}}" },
      "format": "auto",
      "note": "Executive summary + Appendix — currency code."
    },
    {
      "field": "section.executive_summary",
      "target": { "kind": "docx.placeholder", "token": "{{section_executive_summary}}" },
      "format": "auto",
      "note": "AI-written one-page executive summary."
    },
    {
      "field": "section.engagement_context",
      "target": { "kind": "docx.placeholder", "token": "{{section_engagement_context}}" },
      "format": "auto",
      "note": "AI-written engagement context + approach narrative."
    },
    {
      "field": "section.current_state",
      "target": { "kind": "docx.placeholder", "token": "{{section_current_state}}" },
      "format": "auto",
      "note": "AI-written current-state overview."
    },
    {
      "field": "section.key_findings",
      "target": { "kind": "docx.placeholder", "token": "{{section_key_findings}}" },
      "format": "auto",
      "note": "AI-written top findings narrative — replaces the previous findings.bulletList raw dump."
    },
    {
      "field": "section.risks",
      "target": { "kind": "docx.placeholder", "token": "{{section_risks}}" },
      "format": "auto",
      "note": "AI-written risk register narrative — replaces the previous risks.bulletList raw dump."
    },
    {
      "field": "section.recommendations",
      "target": { "kind": "docx.placeholder", "token": "{{section_recommendations}}" },
      "format": "auto",
      "note": "AI-written recommendations + roadmap — replaces the previous recommendations.bulletList raw dump."
    },
    {
      "field": "section.target_state",
      "target": { "kind": "docx.placeholder", "token": "{{section_target_state}}" },
      "format": "auto",
      "note": "AI-written target-state direction narrative."
    },
    {
      "field": "section.team_and_estimate",
      "target": { "kind": "docx.placeholder", "token": "{{section_team_and_estimate}}" },
      "format": "auto",
      "note": "AI-written team composition + estimate context (engine fills the numbers separately)."
    },
    {
      "field": "assessment.findingsCount",
      "target": { "kind": "docx.placeholder", "token": "{{findings_count}}" },
      "format": "auto",
      "note": "Executive summary, Findings header, Appendix counts."
    },
    {
      "field": "assessment.risksCount",
      "target": { "kind": "docx.placeholder", "token": "{{risks_count}}" },
      "format": "auto",
      "note": "Executive summary, Risks header, Appendix counts."
    },
    {
      "field": "assessment.recommendationsCount",
      "target": { "kind": "docx.placeholder", "token": "{{recommendations_count}}" },
      "format": "auto",
      "note": "Executive summary, Recommendations header, Appendix counts."
    },
    {
      "field": "generated.date",
      "target": { "kind": "docx.placeholder", "token": "{{generated_date}}" },
      "format": "date",
      "note": "Cover + Appendix — generation date."
    }
  ]
}
