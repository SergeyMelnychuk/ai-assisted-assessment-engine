// ─── Repository linking (Week 6, ADR-0009/0010) ──────────────

// A RepositoryLink binds an Assessment to a remote code repository.
// Credentials (PAT) are AES-256-GCM encrypted at rest with a key in
// `REPO_CREDENTIAL_KEY`. Ingest reuses the Week 5 archive pipeline —
// we fetch a tarball via the provider API, persist it under a parent
// Document, and the existing `ingest-archive` worker fans out one
// `ingest-document` per surviving child.
model RepositoryLink {
  id                    String       @id @default(cuid())
  assessmentId          String       @map("assessment_id")
  url                   String
  provider              String
  authMethod            String       @map("auth_method")
  /// Pointer into the engagement-scoped credential vault. The PAT
  /// itself lives there. The legacy in-row encrypted columns were
  /// dropped after the Slice 3 backfill consolidated every PAT into
  /// the vault (see migration `20260427201500_drop_legacy_pat_cols`).
  agentCredentialId     String?      @map("agent_credential_id")
  lastSyncedAt          DateTime?    @map("last_synced_at")
  lastSha               String?      @map("last_sha")
  ingestStatus          IngestStatus @default(PENDING) @map("ingest_status")
  parentDocumentId      String?      @map("parent_document_id")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  parentDocument Document?  @relation("RepoLinkParentDocument", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  agentCredential AgentCredential? @relation(fields: [agentCredentialId], references: [id], onDelete: SetNull)

  @@index([assessmentId])
  @@index([agentCredentialId])
  @@map("repository_links")
}

// ─── Templates (Phase 4 Slice 4 — customer-uploadable) ─────────
//
// Customers upload their own estimation workbooks (.xlsx) and
// deliverable templates (.docx, .pptx). The engine's runEstimation +
// generateDeliverable jobs read the engagement's selected template
// and fill it from engine outputs.
//
// Two scopes:
//   - workspace defaults: `engagementId = null` — seeded by
//     packages/knowledge-seed/estimation-templates/* on boot.
//   - per-engagement: `engagementId` set — overrides the default for
//     just that engagement.
//
// Lifecycle: PROPOSED → APPROVED → DEPRECATED. Only APPROVED rows
// appear in pickers; DEPRECATED rows stay so old fills replay
// reproducibly.
//
// Versioning: re-uploading the same `name` for the same scope creates
// a new row (not an in-place update). The previous row flips to
// DEPRECATED on the new row's APPROVED transition. Filled outputs
// reference the exact `templateId` they ran against.

model Template {
  id             String         @id @default(cuid())
  /// null = workspace default, populated = per-engagement override.
  engagementId   String?        @map("engagement_id")
  kind           TemplateKind
  name           String
  /// Manual semver-style version, owned by whoever uploaded.
  /// Combined with `name + scope` produces the picker label.
  version        String
  filename       String
  mimeType       String         @map("mime_type")
  fileSize       Int            @map("file_size")
  /// MinIO object key — `templates/<id>.<ext>`.
  storagePath    String         @map("storage_path")
  /// Binding JSON: maps engine output fields → cell refs / named
  /// ranges / placeholder tokens. See `services/template/binding.ts`
  /// for the schema. Null on first upload, populated by the AI
  /// proposer or by hand-editing.
  bindingJson    Json?          @map("binding_json")
  /// PROPOSED → APPROVED → DEPRECATED.
  status         TemplateStatus @default(PROPOSED)
  uploadedById   String         @map("uploaded_by_id")
  approvedById   String?        @map("approved_by_id")
  approvedAt     DateTime?      @map("approved_at")
  deprecatedAt   DateTime?      @map("deprecated_at")
  archivedAt     DateTime?      @map("archived_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  engagement Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  uploader   User        @relation("TemplateUploader", fields: [uploadedById], references: [id])
  approver   User?       @relation("TemplateApprover", fields: [approvedById], references: [id])
  fills      TemplateFill[]

  @@index([engagementId, kind, status])
  @@index([kind, status])
  @@map("templates")
}

enum TemplateKind {
  ESTIMATION                // Excel WBS workbook
  // Generic deliverable shells (legacy / fallback). Kept so existing
  // rows stay valid; the Deliverables UI prefers a per-deliverable-
  // type kind (below) when one is uploaded and falls back to these.
  DELIVERABLE_REPORT        // Word deliverable shell
  DELIVERABLE_PRESENTATION  // PowerPoint deck shell
  // Per-deliverable-type kinds — 1:1 with the `DeliverableType` enum.
  // Lets a customer upload a different shell per deliverable type
  // (e.g. corporate-branded executive deck vs ops-team risk register).
  // The Deliverables page lists only the types where one of these
  // (or the legacy fallback above) is APPROVED for the engagement.
  EXECUTIVE_SUMMARY
  ASSESSMENT_REPORT
  RISK_REGISTER
  TARGET_STATE
  ROADMAP
  TEAM_PROPOSAL
  ESTIMATE
  ASSUMPTIONS_GAPS
  SOW_DRAFT
  GREENFIELD_DISCOVERY
}

enum TemplateStatus {
  PROPOSED      // uploaded, binding draft only
  APPROVED      // bindings reviewed, eligible for picker
  DEPRECATED    // superseded by a newer version
}

// One row per fill operation. Stores the produced file's MinIO key
// and the engine outputs it consumed, so a fill is reproducible /
// auditable. The `Document` row this references is what lands in the
// engagement's evidence stream + the user's downloads list.
model TemplateFill {
  id            String   @id @default(cuid())
  templateId    String   @map("template_id")
  /// Which assessment ran the fill — fills are always assessment-scoped.
  assessmentId  String   @map("assessment_id")
  /// Snapshot of the template's binding JSON at fill time. Lets us
  /// replay or diff even after the template is re-versioned.
  bindingSnapshot Json?  @map("binding_snapshot")
  /// MinIO key of the produced file. Mime + filename live on the
  /// linked Document row.
  outputDocumentId String? @map("output_document_id")
  /// Subset of the engine outputs that drove this fill — kept for
  /// audit. Trimmed (no PII, no secrets) — see filler service.
  inputsSnapshot Json?    @map("inputs_snapshot")
  /// How many binding entries the filler actually wrote into the
  /// output. 0 means the template had no resolvable placeholders —
  /// the produced file is effectively a blank copy. Surfaced on the
  /// Export page so a no-op fill is never handed over silently.
  /// Nullable for fills created before this column existed.
  filledEntryCount Int?   @map("filled_entry_count")
  /// Filler warnings (unresolved fields, missing sheets, "no
  /// placeholders bound", …). Same array the filler returns; mirrored
  /// here so the UI doesn't have to correlate against the audit log.
  warnings      Json?    @map("warnings")
  filledAt      DateTime @default(now()) @map("filled_at")
  filledById    String?  @map("filled_by_id")

  template       Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  outputDocument Document? @relation("TemplateFillOutput", fields: [outputDocumentId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([assessmentId])
  @@map("template_fills")
}

// ─── Application Log ───────────────────────────────────────────
//
// `Log` captures application-level traces (worker progress, tRPC
// errors, ingest warnings) for operator debugging. Distinct from
// `AuditLog`, which is a business-event ledger (user approved X,
// AI_CALL happened, etc). See `docs/operations/logs.md`.
//
// Retention: rows older than `LOG_RETENTION_DAYS` (default 5) are
// pruned by the `prune-logs` BullMQ job registered as a repeatable
// every 6 h on worker start-up. See
// `apps/web/src/server/queue/jobs/prune-logs.ts`.
model Log {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  level        LogLevel
  source       String
  message      String
  context      Json?
  userId       String?  @map("user_id")
  assessmentId String?  @map("assessment_id")
  jobId        String?  @map("job_id")
  error        String?

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([source])
  @@index([assessmentId])
  @@index([jobId])
  @@map("logs")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// ─── Runtime-editable Settings ─────────────────────────────────
//
// Key/value store for operator-tunable knobs that used to live as
// hard-coded module constants (e.g. DOMAIN_ANALYSIS_CONCURRENCY).
// The point is to let an admin change throughput / pacing without
// shipping code — the engine reads the effective value through
// `settings-service.ts`, which falls back to the constant default
// when the row is absent. `valueJson` is intentionally Json (not a
// string) so we can store numbers, booleans, or small objects
// uniformly; the service layer owns the shape per-key.
//
// Intended cardinality is tiny (< 50 rows). No indexes beyond the
// unique key — every lookup is by `key`.
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueJson Json     @map("value_json")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("settings")
}

// ─── AI model-routing overrides (ADR-0015 §7) ──────────────────
//
// Admin-settable runtime overrides for the task → model-binding
// registry defined in `apps/web/src/server/services/ai/model-
// registry.ts`. One row per task. Used for:
//   • incident response ("Anthropic is overloaded, pin
//     analysis.synthesis to Bedrock for the next hour")
//   • A/B trials of a new provider before editing defaults
//
// `binding` carries a single `ModelBinding` JSON blob (the primary);
// `fallbacks` carries an array of `ModelBinding`. The registry loader
// merges these on top of `DEFAULT_REGISTRY` at boot and after any
// admin write (via `invalidateOverrides`).
//
// `expiresAt` lets a pinning decision auto-revert so a frantic
// incident pin doesn't silently become permanent. NULL = no expiry.

model AiModelOverride {
  id          String    @id @default(cuid())
  task        String    @unique
  binding     Json
  fallbacks   Json      @default("[]")
  reason      String
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  @@map("ai_model_overrides")
}

// ─── Agent Harness (ADR-0014, Phase 4 Slice 0) ─────────────────
//
// Trajectory persistence for the agentic evidence-collection phase.
// An `AgentRun` is one bounded plan-act-observe loop; `AgentStep`
// rows are its ordered turns; `AgentToolCall` rows are individual
// tool invocations produced by TOOL_CALL steps. The full row set
// for a run is sufficient to replay exactly what the model saw —
// that is the reviewability contract. See ADR-0014 §6.
//
// Field naming in this slice follows the Slice 0 spec (idx,
// inputTokens/outputTokens, argsJson/resultJson, errorClass) rather
// than the earlier ADR draft; later slices may widen these shapes.

model AgentRun {
  id              String         @id @default(cuid())
  assessmentId    String         @map("assessment_id")
  engagementId    String         @map("engagement_id")
  planName        String         @map("plan_name")
  status          AgentRunStatus @default(PROPOSED)
  budget          Json
  usage           Json           @default("{}")
  systemPrompt    String         @map("system_prompt")
  systemPromptSha String         @map("system_prompt_sha")
  model           String
  modelFallback   String?        @map("model_fallback")
  approvedById    String?        @map("approved_by_id")
  approvedAt      DateTime?      @map("approved_at")
  startedAt       DateTime?      @map("started_at")
  endedAt         DateTime?      @map("ended_at")
  endReason       String?        @map("end_reason")
  errorDetails    Json?          @map("error_details")
  // Soft-archive — same pattern as Assessment. Hides the row from
  // default lists; child rows (steps, tool calls, credential requests,
  // workflow step status) cascade only on hard `delete`.
  archivedAt      DateTime?      @map("archived_at")
  archivedById    String?        @map("archived_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  assessment           Assessment                @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  engagement           Engagement                @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  steps                AgentStep[]
  credentialRequests   AgentCredentialRequest[]
  workflowStepStatuses WorkflowStepStatus[]

  @@index([assessmentId])
  @@index([engagementId, createdAt])
  @@map("agent_runs")
}

// ─── Agent Credentials (ADR-0014 §8, ADR-0009 pattern) ─────────────
//
// JIT credential flow:
//   1. Executor reaches a step whose tool declares a `requiresCredentials`
//      scope (e.g. "github.pat").
//   2. Vault lookup — if a non-expired, non-revoked `AgentCredential` row
//      exists for (engagementId, scope), the tool receives the decrypted
//      secret via `ToolContext.credentials`.
//   3. Miss → run transitions to AWAITING_USER, a `AgentCredentialRequest`
//      row is opened, the executor returns. The UI renders a modal
//      prompting the user for the secret (with the tool's `reason` +
//      required OAuth-style scopes for display).
//   4. On submit, the secret is encrypted with `encryptCredential()`
//      (AES-256-GCM, `REPO_CREDENTIAL_KEY` — same key as ADR-0009 so
//      rotation is a single operation), written to `AgentCredential`,
//      the request is FULFILLED, and the executor is re-enqueued for
//      `runId` to resume from the paused step.
//
// Scope values are stable strings the tool registry hands out
// ("github.pat", "aws.assume_role_arn", "gcp.workload_identity", …).
// The pair (engagementId, scope) is unique — subsequent grants for the
// same scope overwrite, which is deliberate: rotating a PAT should not
// require a second row.

model AgentCredential {
  id               String    @id @default(cuid())
  engagementId     String    @map("engagement_id")
  // Scope id (e.g. "github.pat"). See tool `requiresCredentials`.
  scope            String
  encryptedSecret  Bytes     @map("encrypted_secret")
  secretIv         Bytes     @map("secret_iv")
  secretTag        Bytes     @map("secret_tag")
  // Non-secret hints for the UI (e.g. `{ org: "acme", scopes: ["repo:read"] }`
  // for a GitHub PAT). Never stores the secret itself.
  metadata         Json?
  createdById      String    @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  // Optional TTL — the tool or the UI sets this based on policy (e.g.
  // 24h for a one-off run). Expired rows are treated as missing and
  // trigger a fresh `AgentCredentialRequest`.
  expiresAt        DateTime? @map("expires_at")
  // Manual revocation (admin or engagement owner). Revoked rows are
  // retained for audit but never decrypted by the executor.
  revokedAt        DateTime? @map("revoked_at")
  revokedById      String?   @map("revoked_by_id")

  engagement      Engagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  repositoryLinks RepositoryLink[]

  @@unique([engagementId, scope])
  @@index([engagementId])
  @@map("agent_credentials")
}

// ─── Workflow step status (Slice 2 — explicit completion lock) ────
//
// One row per (runId, nodeId) capturing the user's explicit state for
// a workflow node. The diagram derives a *soft* status from assessment
// data (see `services/agent/workflow.ts:deriveStepStatus`); when an
// explicit row exists here it overrides the soft derivation. Roll-back
// = delete the explicit row, returning the node to soft-derived state
// without touching the underlying outputs (uploaded docs / answers /
// findings / etc.).
//
// `nodeId` is the planner-emitted `workflow:<idx>:<TYPE>` string. We
// don't FK it to anything because plan nodes live inside the
// `AgentRun.AgentStep.payload` JSON, not as their own rows.

model WorkflowStepStatus {
  id            String                   @id @default(cuid())
  runId         String                   @map("run_id")
  nodeId        String                   @map("node_id")
  status        WorkflowStepExplicitStatus
  /// Free-form notes the user attached on Mark complete / Save.
  note          String?
  updatedById   String?                  @map("updated_by_id")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeId])
  @@index([runId])
  @@map("workflow_step_status")
}

enum WorkflowStepExplicitStatus {
  IN_PROGRESS
  COMPLETED
}

model AgentCredentialRequest {
  id              String                  @id @default(cuid())
  runId           String                  @map("run_id")
  // The step that asked — null only for plan-time pre-flight checks.
  stepId          String?                 @map("step_id")
  scope           String
  // Human-readable justification surfaced to the user in the prompt.
  reason          String
  // Provider-side scopes required (e.g. ["repo:read", "workflow:read"]).
  // Shown to the user so they grant a least-privilege token.
  requiredScopes  String[]                @map("required_scopes")
  status          CredentialRequestStatus @default(PENDING)
  fulfilledAt     DateTime?               @map("fulfilled_at")
  fulfilledById   String?                 @map("fulfilled_by_id")
  // Captured if the user declines — surfaced on the run timeline.
  denialReason    String?                 @map("denial_reason")
  createdAt       DateTime                @default(now()) @map("created_at")

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@map("agent_credential_requests")
}

enum CredentialRequestStatus {
  PENDING
  FULFILLED
  DENIED
  EXPIRED
  SUPERSEDED
}

enum AgentRunStatus {
  PROPOSED
  APPROVED
  RUNNING
  AWAITING_USER
  COMPLETED
  BUDGET_EXHAUSTED
  CANCELLED
  FAILED
}

model AgentStep {
  id           String        @id @default(cuid())
  runId        String        @map("run_id")
  idx          Int
  kind         AgentStepKind
  payload      Json
  inputTokens  Int           @default(0) @map("input_tokens")
  outputTokens Int           @default(0) @map("output_tokens")
  createdAt    DateTime      @default(now()) @map("created_at")

  run         AgentRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolCalls   AgentToolCall[]
  annotations AgentStepAnnotation[]

  @@unique([runId, idx])
  @@map("agent_steps")
}

enum AgentStepKind {
  PLAN
  TOOL_CALL
  ASSISTANT
  USER_INPUT
  SYSTEM
}

// Reviewer annotations on agent steps. One-to-many on `AgentStep`;
// captured in the step-inspection side panel so a reviewer can pin
// "this failure mode is worth following up" without leaving the
// trace. Anyone with read access on the parent assessment may write.
// Soft-delete via the `resolvedAt` flag rather than hard delete so the
// audit trail of "someone flagged this once" survives.
model AgentStepAnnotation {
  id          String    @id @default(cuid())
  stepId      String    @map("step_id")
  authorId    String?   @map("author_id")
  body        String
  resolvedAt  DateTime? @map("resolved_at")
  resolvedById String?  @map("resolved_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  step AgentStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@map("agent_step_annotations")
}

model AgentToolCall {
  id           String         @id @default(cuid())
  stepId       String         @map("step_id")
  toolName     String         @map("tool_name")
  argsJson     Json           @map("args_json")
  status       ToolCallStatus
  startedAt    DateTime       @map("started_at")
  endedAt      DateTime?      @map("ended_at")
  durationMs   Int?           @map("duration_ms")
  resultJson   Json?          @map("result_json")
  errorClass   String?        @map("error_class")
  evidenceIds  String[]       @default([]) @map("evidence_ids")

  step AgentStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([toolName, status])
  @@map("agent_tool_calls")
}

enum ToolCallStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
}

// ─── Audit Trail ───────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
