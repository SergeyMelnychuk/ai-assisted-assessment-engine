generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Users ──────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String   @map("password_hash")
  role           UserRole @default(ASSESSOR)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  engagementMembers   EngagementMember[]
  answers             Answer[]
  reviews             Review[]
  documents           Document[]
  auditLogs           AuditLog[]
  templatesUploaded   Template[] @relation("TemplateUploader")
  templatesApproved   Template[] @relation("TemplateApprover")

  @@map("users")
}

enum UserRole {
  ADMIN
  ASSESSOR
  REVIEWER
  VIEWER
}

// ─── Engagement ────────────────────────────────────────────────

model Engagement {
  id         String           @id @default(cuid())
  name       String
  clientName String           @map("client_name")
  industry   String?
  status     EngagementStatus @default(DRAFT)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  members           EngagementMember[]
  assessments       Assessment[]
  agentRuns         AgentRun[]
  agentCredentials  AgentCredential[]
  templates         Template[]

  @@map("engagements")
}

enum EngagementStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

model EngagementMember {
  id           String         @id @default(cuid())
  engagementId String         @map("engagement_id")
  userId       String         @map("user_id")
  role         EngagementRole @default(CONTRIBUTOR)

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([engagementId, userId])
  @@map("engagement_members")
}

enum EngagementRole {
  OWNER
  CONTRIBUTOR
  REVIEWER
  VIEWER
}

// ─── Assessment ────────────────────────────────────────────────

model Assessment {
  id               String          @id @default(cuid())
  engagementId     String          @map("engagement_id")
  assessmentTypeId String          @map("assessment_type_id")
  mode             AssessmentMode
  evidenceMode     EvidenceMode    @default(MANUAL) @map("evidence_mode")
  status           AssessmentStage @default(SETUP)
  activeDomains    String[]        @map("active_domains")
  overallConfidence Float?         @map("overall_confidence")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // Soft-archive: `archivedAt` null ⇒ active, non-null ⇒ archived.
  // Archived assessments are hidden from default lists and must be
  // archived before they can be hard-deleted. `archivedById` stores
  // the acting user's id as a string (no FK) — the AuditLog row
  // created alongside the transition is the authoritative relation.
  archivedAt       DateTime?       @map("archived_at")
  archivedById     String?         @map("archived_by_id")

  engagement     Engagement     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  assessmentType AssessmentType @relation(fields: [assessmentTypeId], references: [id])

  projectContext  ProjectContext?
  documents       Document[]
  evidences       Evidence[]
  evidenceSources EvidenceSource[]
  questions       Question[]
  domainScores    DomainScore[]
  findings        Finding[]
  risks           Risk[]
  recommendations Recommendation[]
  assumptions     Assumption[]
  roleProposals   RoleProposal[]
  estimates       Estimate[]
  deliverables    Deliverable[]
  diagrams        Diagram[]

  deliveryStrategyAssessment       DeliveryStrategyAssessment?
  testStrategyAssessment           TestStrategyAssessment?
  dataDistributionAssessment       DataDistributionAssessment?
  storageAssessment                StorageAssessment?
  infrastructureMaturityAssessment InfrastructureMaturityAssessment?

  repositoryLinks RepositoryLink[]
  agentRuns       AgentRun[]
  templateFills   TemplateFill[]

  @@map("assessments")
}

enum EvidenceMode {
  MANUAL
  AGENTIC
}

enum AssessmentMode {
  EXISTING_SYSTEM
  GREENFIELD
  MODERNIZATION
  AUDIT
  PRE_IMPLEMENTATION
}

enum AssessmentStage {
  SETUP
  INTAKE
  QUESTIONING
  ANALYSIS
  DRAFTING
  REVIEW
  COMPLETED
}

model AssessmentType {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String
  defaultDomains String[] @map("default_domains")
  defaultMode    AssessmentMode @map("default_mode")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  assessments Assessment[]

  @@map("assessment_types")
}

// ─── Project Context ───────────────────────────────────────────

model ProjectContext {
  id                     String   @id @default(cuid())
  assessmentId           String   @unique @map("assessment_id")
  projectName            String?  @map("project_name")
  description            String?
  industry               String?
  cloudProviders         String[] @map("cloud_providers")
  platforms              String[] @map("platforms")
  knownConstraints       String?  @map("known_constraints")
  businessGoals          String?  @map("business_goals")
  expectedTimeline       String?  @map("expected_timeline")
  budgetSensitivity      BudgetSensitivity? @map("budget_sensitivity")
  targetDeliveryModel    String?  @map("target_delivery_model")
  estimatedUsers         String?  @map("estimated_users")
  complianceRequirements String[] @map("compliance_requirements")
  existingTeamSummary    String?  @map("existing_team_summary")
  isGreenfield           Boolean  @default(false) @map("is_greenfield")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("project_contexts")
}

enum BudgetSensitivity {
  LOW
  MEDIUM
  HIGH
}

// ─── Documents & Evidence ──────────────────────────────────────

model Document {
  id               String           @id @default(cuid())
  assessmentId     String           @map("assessment_id")
  filename         String
  mimeType         String           @map("mime_type")
  storagePath      String           @map("storage_path")
  fileSize         Int              @map("file_size")
  uploadType       DocumentType     @map("upload_type")
  // `ingestStatus` tracks the deterministic pipeline (download → extract
  // → chunk → (embed, Week 3) → READY). AI analysis lives on the
  // per-assessment `run-analysis` job now; this column has no AI state.
  // See ADR-0001.
  ingestStatus     IngestStatus     @default(PENDING) @map("ingest_status")
  // `processingStatus` is kept for backwards-compat with existing audit
  // rows and retry surfaces. New writers should prefer `ingestStatus`;
  // the two are kept in sync by the ingest worker during the transition.
  processingStatus ProcessingStatus @default(PENDING) @map("processing_status")
  extractedText    String?          @map("extracted_text")
  extractedSummary String?          @map("extracted_summary")
  chunkCount       Int?             @map("chunk_count")
  uploadedById     String           @map("uploaded_by_id")
  // Archive fan-out (Week 5, ADR-0008). Null on plain uploads; set
  // on children extracted from an archive. The parent itself stays
  // with `parent_document_id = NULL` and is surfaced to the UI as an
  // "archive" purely via the presence of child rows.
  parentDocumentId String?          @map("parent_document_id")
  // Optional domain tag the user picked at upload time. When set,
  // the ingest worker stamps every chunk of this document with this
  // domain instead of the default `"ingested"` catch-all bucket.
  // NULL = use the catch-all (back-compat with existing rows).
  domain           String?          @map("domain")
  createdAt        DateTime         @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation(fields: [uploadedById], references: [id])
  evidences  Evidence[]
  diagrams   Diagram[]

  parentDocument Document?  @relation("DocumentArchive", fields: [parentDocumentId], references: [id], onDelete: Cascade)
  childDocuments Document[] @relation("DocumentArchive")

  // Week 6 (ADR-0009/0010): repository links whose tarball is persisted
  // under this Document as the archive parent. `onDelete: SET NULL` is
  // set in the 20260420 migration; mirrored here so Prisma's drift check
  // passes.
  repositoryLinks RepositoryLink[] @relation("RepoLinkParentDocument")
  templateFills   TemplateFill[]   @relation("TemplateFillOutput")

  @@index([parentDocumentId])
  @@map("documents")
}

enum DocumentType {
  RFP
  ARCHITECTURE_DOC
  NFR_DOC
  BACKLOG
  API_SPEC
  DIAGRAM_STRUCTURIZR
  DIAGRAM_MERMAID
  DIAGRAM_PLANTUML
  DIAGRAM_WEBSEQUENCE
  DIAGRAM_IMAGE
  DIAGRAM_SVG
  DIAGRAM_OTHER
  MEETING_NOTES
  INCIDENT_SUMMARY
  SECURITY_DOC
  OPERATIONAL_MANUAL
  MIGRATION_NOTES
  PROPOSAL
  OTHER
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

// Ingest pipeline state for a Document. Distinct from AI analysis —
// the per-assessment `run-analysis` job owns that. `EMBEDDED` is
// reserved for Week 3 (embedding foundation) and MUST NOT be written
// by the Week 1 ingest worker.
enum IngestStatus {
  PENDING
  EXTRACTING
  CHUNKED
  EMBEDDED
  READY
  FAILED
}

// ─── Diagrams (parsed + generated) ────────────────────────────

model Diagram {
  id               String            @id @default(cuid())
  assessmentId     String            @map("assessment_id")
  documentId       String?           @map("document_id")
  deliverableId    String?           @map("deliverable_id")
  direction        DiagramDirection  @default(INGESTED)
  diagramFormat    DiagramFormat     @map("diagram_format")
  title            String
  description      String?
  sourceCode       String?           @map("source_code")         // text-based diagram source (mermaid, plantuml, structurizr DSL, wsd)
  imageStoragePath String?           @map("image_storage_path")  // S3 path for rendered image or uploaded image
  svgContent       String?           @map("svg_content")         // inline SVG if available
  extractedEntities Json?            @map("extracted_entities")  // components, services, connections, layers parsed from diagram
  extractedSummary String?           @map("extracted_summary")   // AI-generated description of what the diagram shows
  diagramType      DiagramContentType? @map("diagram_type")      // what the diagram represents
  processingStatus ProcessingStatus  @default(PENDING) @map("processing_status")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  assessment  Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  document    Document?    @relation(fields: [documentId], references: [id])
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id])

  @@map("diagrams")
}

enum DiagramDirection {
  INGESTED    // parsed from uploaded input
  GENERATED   // produced by the system as deliverable output
}

enum DiagramFormat {
  STRUCTURIZR
  MERMAID
  PLANTUML
  WEBSEQUENCEDIAGRAMS
  PNG
  SVG
  JPEG
  DRAW_IO
  OTHER
}

enum DiagramContentType {
  SYSTEM_CONTEXT
  CONTAINER
  COMPONENT
  DEPLOYMENT
  SEQUENCE
  DATA_FLOW
  NETWORK_TOPOLOGY
  ER_DIAGRAM
  STATE_MACHINE
  ACTIVITY_FLOW
  INFRASTRUCTURE
  OTHER
}

model Evidence {
  id           String         @id @default(cuid())
  assessmentId String         @map("assessment_id")
  sourceType   EvidenceSourceType @map("source_type")
  documentId   String?        @map("document_id")
  answerId     String?        @map("answer_id")
  content      String
  domain       String
  confidence   Float          @default(0.5)
  // Week 3 (ADR-0003/0004/0005): embedding foundation. All four columns
  // are nullable so the backfill script can catch up incrementally;
  // new rows written by the Week 3 ingest worker always populate them.
  // `embedding` is `Unsupported("vector(1536)")` — Prisma can't type
  // pgvector's column type, so reads/writes go through raw SQL.
  embedding     Unsupported("vector(1536)")?
  // ADR-0027: lexical search backbone. Stored generated column —
  // Postgres maintains it from `content` automatically (created in
  // migration 20260512165717 via `GENERATED ALWAYS AS (...) STORED`).
  // Prisma can't type tsvector so reads/writes go through raw SQL in
  // the retriever.
  //
  // The `@default(dbgenerated(...))` + `@@index(type: Gin)` below are
  // NOT cosmetic: they are exactly what `prisma db pull` introspects
  // this column + index into. Without them, `prisma migrate dev`
  // shadow-diffs the (generated, GIN-indexed) DB column against a
  // plain schema column and emits spurious `ALTER COLUMN ... DROP
  // DEFAULT` + `DROP INDEX` statements on every new migration. Keeping
  // the schema's representation identical to introspection makes that
  // diff empty. The expression string must match introspection's
  // normalised form verbatim (regconfig cast, uppercase COALESCE,
  // ::text cast) — re-derive with `prisma db pull` if Postgres ever
  // rewrites it.
  searchVec     Unsupported("tsvector")?    @map("search_vec") @default(dbgenerated("to_tsvector('english'::regconfig, COALESCE(content, ''::text))"))
  chunkIndex    Int?        @map("chunk_index")
  chunkSource   Json?       @map("chunk_source")
  contentSha    String?     @map("content_sha")
  createdAt    DateTime       @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  document   Document?  @relation(fields: [documentId], references: [id])
  answer     Answer?    @relation(fields: [answerId], references: [id])

  @@index([contentSha])
  @@index([searchVec], type: Gin)
  @@map("evidences")
}

enum EvidenceSourceType {
  DOCUMENT
  ANSWER
  ARTIFACT
  CONNECTOR
}

model EvidenceSource {
  id               String                 @id @default(cuid())
  assessmentId     String                 @map("assessment_id")
  sourceType       ConnectorType          @map("source_type")
  connectionStatus ConnectionStatus       @default(PENDING_APPROVAL) @map("connection_status")
  connectionConfig Json?                  @map("connection_config")
  approvedById     String?                @map("approved_by_id")
  approvedAt       DateTime?              @map("approved_at")
  createdAt        DateTime               @default(now()) @map("created_at")

  assessment          Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  artifactValidations ArtifactValidation[]

  @@map("evidence_sources")
}

enum ConnectorType {
  REPOSITORY
  IAC_REPO
  CICD
  CLOUD_CONFIG
  K8S
  MONITORING
  TEST_REPORT
  DATABASE_SCHEMA
  BACKLOG_SYSTEM
  DOCUMENTATION
}

enum ConnectionStatus {
  PENDING_APPROVAL
  CONNECTED
  FAILED
  DISCONNECTED
}

model ArtifactValidation {
  id               String           @id @default(cuid())
  assessmentId     String           @map("assessment_id")
  evidenceSourceId String           @map("evidence_source_id")
  claimText        String           @map("claim_text")
  artifactFinding  String           @map("artifact_finding")
  status           ValidationStatus
  notes            String?
  createdAt        DateTime         @default(now()) @map("created_at")

  evidenceSource EvidenceSource @relation(fields: [evidenceSourceId], references: [id], onDelete: Cascade)

  @@map("artifact_validations")
}

enum ValidationStatus {
  CONFIRMED
  CONTRADICTED
  PARTIALLY_CONFIRMED
  INCONCLUSIVE
}

// ─── Questions & Answers ───────────────────────────────────────

model Question {
  id            String         @id @default(cuid())
  assessmentId  String         @map("assessment_id")
  domain        String
  questionText  String         @map("question_text")
  questionType  QuestionType   @map("question_type")
  options       Json?
  priority      Priority       @default(MEDIUM)
  dependsOn     String[]       @map("depends_on")
  isAnswered    Boolean        @default(false) @map("is_answered")
  generatedBy   GeneratedBy    @default(AI) @map("generated_by")
  rationale     String?
  stage         QuestionStage  @default(INTAKE)
  orderIndex    Int            @default(0) @map("order_index")
  createdAt     DateTime       @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers    Answer[]

  @@map("questions")
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  FREE_TEXT
  NUMERIC
  FILE_UPLOAD
  CONFIRMATION
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum GeneratedBy {
  AI
  TEMPLATE
  MANUAL
}

enum QuestionStage {
  INTAKE
  FOLLOW_UP
  CLARIFICATION
  EVIDENCE_REQUEST
}

model Answer {
  id             String   @id @default(cuid())
  questionId     String   @map("question_id")
  answerText     String?  @map("answer_text")
  answerData     Json?    @map("answer_data")
  answeredById   String   @map("answered_by_id")
  confidenceNote String?  @map("confidence_note")
  createdAt      DateTime @default(now()) @map("created_at")

  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answeredBy User       @relation(fields: [answeredById], references: [id])
  evidences  Evidence[]

  @@map("answers")
}

// ─── Scoring ───────────────────────────────────────────────────

model DomainScore {
  id              String       @id @default(cuid())
  assessmentId    String       @map("assessment_id")
  domain          String
  score           Float
  maturityLevel   MaturityLevel @map("maturity_level")
  confidence      Float        @default(0.5)
  scoringRationale String?     @map("scoring_rationale")
  // Week 7 (ADR-0011): the full set of Evidence chunks the retriever
  // gave the scoring prompt. `evidenceIds` on Finding/Risk/Rec reflects
  // what the model cited; this is what it *had*. Additive, defaults to
  // an empty array so pre-W7 rows stay valid.
  retrievedEvidenceIds String[] @default([]) @map("retrieved_evidence_ids")
  reviewStatus    ReviewStatus @default(DRAFT) @map("review_status")
  reviewedById    String?      @map("reviewed_by_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, domain])
  @@map("domain_scores")
}

enum MaturityLevel {
  AD_HOC
  INITIAL
  DEFINED
  MANAGED
  OPTIMIZED
}

// ─── Findings, Risks, Recommendations ─────────────────────────

model Finding {
  id           String       @id @default(cuid())
  assessmentId String       @map("assessment_id")
  domain       String
  findingType  FindingType  @map("finding_type")
  title        String
  description  String
  evidenceIds  String[]     @map("evidence_ids")
  // Week 7 (ADR-0011): full retriever output that bounded the model's
  // choice. Superset of `evidenceIds`.
  retrievedEvidenceIds String[] @default([]) @map("retrieved_evidence_ids")
  confidence   Float        @default(0.5)
  severity     Severity     @default(MEDIUM)
  reviewStatus ReviewStatus @default(DRAFT) @map("review_status")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("findings")
}

enum FindingType {
  STRENGTH
  WEAKNESS
  GAP
  OBSERVATION
  OPPORTUNITY
}

model Risk {
  id                 String       @id @default(cuid())
  assessmentId       String       @map("assessment_id")
  title              String
  category           String
  description        String
  evidenceIds        String[]     @map("evidence_ids")
  // Week 7 (ADR-0011): full retriever output that bounded the model's choice.
  retrievedEvidenceIds String[]  @default([]) @map("retrieved_evidence_ids")
  impact             Severity
  likelihood         Likelihood
  severity           Severity
  mitigationProposal String?      @map("mitigation_proposal")
  ownerSuggestion    String?      @map("owner_suggestion")
  confidence         Float        @default(0.5)
  reviewStatus       ReviewStatus @default(DRAFT) @map("review_status")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("risks")
}

enum Likelihood {
  VERY_LIKELY
  LIKELY
  POSSIBLE
  UNLIKELY
}

model Recommendation {
  id               String       @id @default(cuid())
  assessmentId     String       @map("assessment_id")
  domain           String
  title            String
  description      String
  priority         Priority     @default(MEDIUM)
  effortIndication String?      @map("effort_indication")
  evidenceIds      String[]     @map("evidence_ids")
  // Week 7 (ADR-0011): full retriever output that bounded the model's choice.
  // For Recommendation we take the union of the originating finding's
  // retrieved set so the reviewer can trace a rec back through its
  // finding to the chunks both had in context.
  retrievedEvidenceIds String[] @default([]) @map("retrieved_evidence_ids")
  relatedRiskIds   String[]     @map("related_risk_ids")
  confidence       Float        @default(0.5)
  reviewStatus     ReviewStatus @default(DRAFT) @map("review_status")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("recommendations")
}

model Assumption {
  id                 String          @id @default(cuid())
  assessmentId       String          @map("assessment_id")
  assumptionText     String          @map("assumption_text")
  impactIfWrong      String?         @map("impact_if_wrong")
  source             AssumptionSource
  confidence         Float           @default(0.5)
  requiresValidation Boolean         @default(true) @map("requires_validation")
  createdAt          DateTime        @default(now()) @map("created_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assumptions")
}

enum AssumptionSource {
  AI_INFERRED
  STAKEHOLDER_STATED
  EVIDENCE_BASED
}

// ─── Team & Estimation ─────────────────────────────────────────

model RoleProposal {
  id               String       @id @default(cuid())
  assessmentId     String       @map("assessment_id")
  roleName         String       @map("role_name")
  seniority        Seniority
  count            Int          @default(1)
  justification    String
  responsibilities String
  phase            String?
  expertiseRequired String[]    @map("expertise_required")
  reviewStatus     ReviewStatus @default(DRAFT) @map("review_status")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("role_proposals")
}

enum Seniority {
  JUNIOR
  MID
  SENIOR
  LEAD
  PRINCIPAL
}

model Estimate {
  id                  String       @id @default(cuid())
  assessmentId        String       @map("assessment_id")
  scenarioName        String       @map("scenario_name")
  totalEffortHoursLow Int          @map("total_effort_hours_low")
  totalEffortHoursHigh Int         @map("total_effort_hours_high")
  totalCostLow        Decimal      @map("total_cost_low") @db.Decimal(12, 2)
  totalCostHigh       Decimal      @map("total_cost_high") @db.Decimal(12, 2)
  rateCardId          String       @map("rate_card_id")
  roleAllocations     Json         @map("role_allocations")
  assumptions         String?
  confidence          Float        @default(0.5)
  reviewStatus        ReviewStatus @default(DRAFT) @map("review_status")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  rateCard   RateCard   @relation(fields: [rateCardId], references: [id])

  @@map("estimates")
}

model RateCard {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("USD")
  rates     Json     // [{role, seniority, hourlyRate, dailyRate}]
  validFrom DateTime @map("valid_from")
  validTo   DateTime? @map("valid_to")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  estimates Estimate[]

  @@map("rate_cards")
}

// ─── Deliverables & Review ─────────────────────────────────────

model Deliverable {
  id             String          @id @default(cuid())
  assessmentId   String          @map("assessment_id")
  deliverableType DeliverableType @map("deliverable_type")
  templateId     String?         @map("template_id")
  status         DeliverableStatus @default(GENERATING)
  createdAt      DateTime        @default(now()) @map("created_at")
